# Copy to .env and fill in. Everything is optional: with nothing set, signups
# are stored locally in data/signups.json and nothing is sent to third parties.

PORT=3000

# Set to 1 when running behind a proxy/CDN so the real visitor IP is used for rate limiting.
TRUST_PROXY=0

# Protects GET /api/admin/signups.csv (send as "Authorization: Bearer <token>").
ADMIN_TOKEN=

# Klaviyo (email + SMS). Private API key with profiles:write, lists:write, subscriptions:write.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Cloudflare Turnstile (invisible bot check). Both keys are needed to enable it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
